# Copy this file to .env.local and fill in your keys.
# .env.local is git-ignored. CRA only reads env vars on `npm start` —
# restart the dev server after changing this file.

# Finnhub — free tier, 60 req/min. Sign up: https://finnhub.io/register
# Without this key the news section falls back to bundled mock headlines.
REACT_APP_FINNHUB_KEY=
